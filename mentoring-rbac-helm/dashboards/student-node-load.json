      "title": "Student share of node memory",
      "description": "Part of each node's allocatable memory used by the selected student namespaces.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (node_namespace_pod_container:container_memory_working_set_bytes{namespace=~\"$namespace\", node=~\"$node\", container!=\"\"}) / on(node) sum by (node) (kube_node_status_allocatable{resource=\"memory\", node=~\"$node\"})",
