        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Student share of node CPU",
      "description": "Part of each node's allocatable CPU used by the selected student namespaces.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{namespace=~\"$namespace\", node=~\"$node\", container!=\"\"}) / on(node) sum by (node) (kube_node_status_allocatable{resource=\"cpu\", node=~\"$node\"})",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "time_series"
