    {
      "id": 15,
      "type": "row",
      "title": "Current usage, requests and limits (node \u00d7 namespace)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Node \u00d7 namespace",
      "description": "Requests and limits include native sidecars such as istio-proxy. Empty cells mean the pods do not set them.",
      "targets": [
        {
          "refId": "A",
          "expr": "count by (node, namespace) ((kube_pod_info{namespace=~\"$namespace\", node=~\"$node\"} * on(namespace, pod) group_left() (kube_pod_status_phase{namespace=~\"$namespace\", phase=\"Running\"} == 1)))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "sum by (node, namespace) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{namespace=~\"$namespace\", node=~\"$node\", container!=\"\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "sum by (node, namespace) (kube_pod_container_resource_requests{namespace=~\"$namespace\", node=~\"$node\", resource=\"cpu\"} or (kube_pod_init_container_resource_requests{namespace=~\"$namespace\", node=~\"$node\", resource=\"cpu\"} * on(namespace, pod, container) group_left() kube_pod_init_container_info{namespace=~\"$namespace\", restart_policy=\"Always\"}))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "expr": "sum by (node, namespace) (kube_pod_container_resource_limits{namespace=~\"$namespace\", node=~\"$node\", resource=\"cpu\"} or (kube_pod_init_container_resource_limits{namespace=~\"$namespace\", node=~\"$node\", resource=\"cpu\"} * on(namespace, pod, container) group_left() kube_pod_init_container_info{namespace=~\"$namespace\", restart_policy=\"Always\"}))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "E",
          "expr": "sum by (node, namespace) (node_namespace_pod_container:container_memory_working_set_bytes{namespace=~\"$namespace\", node=~\"$node\", container!=\"\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "F",
          "expr": "sum by (node, namespace) (kube_pod_container_resource_requests{namespace=~\"$namespace\", node=~\"$node\", resource=\"memory\"} or (kube_pod_init_container_resource_requests{namespace=~\"$namespace\", node=~\"$node\", resource=\"memory\"} * on(namespace, pod, container) group_left() kube_pod_init_container_info{namespace=~\"$namespace\", restart_policy=\"Always\"}))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "G",
          "expr": "sum by (node, namespace) (kube_pod_container_resource_limits{namespace=~\"$namespace\", node=~\"$node\", resource=\"memory\"} or (kube_pod_init_container_resource_limits{namespace=~\"$namespace\", node=~\"$node\", resource=\"memory\"} * on(namespace, pod, container) group_left() kube_pod_init_container_info{namespace=~\"$namespace\", restart_policy=\"Always\"}))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
